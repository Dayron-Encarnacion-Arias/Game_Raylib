{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build release",
      "type": "process",
      "command": "C:/raylib/w64devkit/bin/mingw32-make.exe",
      "args": ["-B", "RAYLIB_PATH=C:/raylib/raylib"],
      "problemMatcher": ["$gcc"],
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "build debug",
      "type": "process",
      "command": "C:/raylib/w64devkit/bin/mingw32-make.exe",
      "args": ["-B", "RAYLIB_PATH=C:/raylib/raylib", "BUILD_MODE=DEBUG"],
      "problemMatcher": ["$gcc"],
      "group": {"kind": "build", "isDefault": false}
    }
  ]
}
